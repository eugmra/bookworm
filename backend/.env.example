# Copy to backend/.env and fill in every empty value. Never commit the real .env file.
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Comma-separated browser origins allowed to call mutating endpoints (same-origin is always allowed)
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bookworm
DB_USER=bookworm
DB_PASSWORD=
# Set to true when the database requires TLS
DB_SSL=false

# JWT signing secret (at least 32 characters)
JWT_SECRET=
SESSION_HOURS=2

# Only used by `npm run db:seed` for the demo accounts (at least 12 characters)
DEMO_USER_PASSWORD=
